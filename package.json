{
  "name": "sovereign-root",
  "version": "0.1.0",
  "private": true,
  "description": "Sovereign Specialty Clinical Intelligence & Execution Platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "verify": "pnpm run test:phi && pnpm run test:arch && pnpm run test:tenant-predicates && pnpm run test:roles && pnpm run test && pnpm run test:adversarial && pnpm run test:coverage",
    "test:arch": "tsx scripts/verify-architecture.ts",
    "test:tenant-predicates": "tsx scripts/verify-tenant-predicates.ts",
    "test:phi": "tsx scripts/verify-synthetic-data.ts",
    "compile:roles": "tsx scripts/compile-role-matrix.ts",
    "test:roles": "tsx scripts/compile-role-matrix.ts --check",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:adversarial": "vitest run tests/adversarial",
    "test:coverage": "vitest run --coverage.enabled --coverage.include=packages/crypto/src/** tests/crypto-envelope.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@sovereign/adapter-identity-oidc": "workspace:*",
    "@sovereign/adapter-identity-scim": "workspace:*",
    "@sovereign/adapter-siem-export": "workspace:*",
    "@sovereign/application": "workspace:*",
    "@sovereign/contracts": "workspace:*",
    "@sovereign/crypto": "workspace:*",
    "@sovereign/domain": "workspace:*",
    "@sovereign/gateway": "workspace:*",
    "@sovereign/job-audit-anchor": "workspace:*",
    "@sovereign/job-outbox-relay": "workspace:*",
    "@sovereign/kernel": "workspace:*",
    "@sovereign/persistence": "workspace:*",
    "@sovereign/service-audit": "workspace:*",
    "@sovereign/service-identity": "workspace:*",
    "@sovereign/service-metering": "workspace:*",
    "@sovereign/service-patient-context": "workspace:*",
    "@sovereign/service-retention": "workspace:*",
    "@sovereign/provider-ai-fake": "workspace:*",
    "@sovereign/telemetry": "workspace:*",
    "@sovereign/ui": "workspace:*",
    "@types/node": "^20.17.19",
    "@types/pg": "^8.11.11",
    "@vitest/coverage-v8": "^3.2.7",
    "fastify": "^5.12.5",
    "jose": "^5.10.0",
    "kysely": "^0.28.14",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6",
    "yaml": "^2.9.1",
    "zod": "^3.24.2"
  },
  "pnpm": {
    "overrides": {
      "tmp": ">=0.2.6",
      "vite": ">=6.4.3",
      "postcss": ">=8.5.18"
    },
    "auditConfig": {
      "ignoreGhsas": ["GHSA-jmr9-qjv8-65gv", "GHSA-7pqw-9j4j-h8q3"]
    },
    "_auditNotes": "ignoreGhsas: extract-zip advisories with no patched version; reachable only via @lhci/cli (Lighthouse, dev-only, marketing-site CI). Re-evaluate each quarter (WO-002A AC-06)."
  }
}
